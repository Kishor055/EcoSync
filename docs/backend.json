{
  "entities": {
    "user": {
      "title": "User",
      "description": "Enterprise user profile with sustainability metrics.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email"]
    },
    "appliance": {
      "title": "Appliance",
      "description": "Monitored home appliance.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "efficiencyRating": { "type": "string", "enum": ["A", "B", "C", "D"] },
        "energyConsumption": { "type": "number" },
        "waterConsumption": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "type", "efficiencyRating", "energyConsumption"]
    },
    "marketplaceItem": {
      "title": "Marketplace Item",
      "description": "Items listed for donation or recycling.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "condition": { "type": "string" },
        "imageUrl": { "type": "string" },
        "donorId": { "type": "string" },
        "status": { "type": "string", "enum": ["available", "pending", "claimed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "feedPost": {
      "title": "Community Post",
      "description": "Social updates in the eco-community.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "likes": { "type": "number" },
        "type": { "type": "string", "enum": ["update", "achievement", "milestone"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "email", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/user" },
      "description": "User profile data."
    },
    "/users/{userId}/appliances/{applianceId}": {
      "schema": { "$ref": "#/entities/appliance" },
      "description": "User appliances."
    },
    "/marketplace/{itemId}": {
      "schema": { "$ref": "#/entities/marketplaceItem" },
      "description": "Community marketplace listings."
    },
    "/feed/{postId}": {
      "schema": { "$ref": "#/entities/feedPost" },
      "description": "Global community activity feed."
    }
  }
}