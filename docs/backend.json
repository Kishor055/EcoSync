
{
  "entities": {
    "user": {
      "title": "User",
      "description": "Enterprise user profile.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email"]
    },
    "appliance": {
      "title": "Appliance",
      "description": "Monitored home appliance.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "efficiencyRating": { "type": "string", "enum": ["A", "B", "C", "D"] },
        "energyConsumption": { "type": "number" },
        "waterConsumption": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "type", "efficiencyRating", "energyConsumption"]
    },
    "activity": {
      "title": "Activity Log",
      "description": "User sustainability actions.",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "impactScore": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "email", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/user" },
      "description": "User profile data."
    },
    "/users/{userId}/appliances/{applianceId}": {
      "schema": { "$ref": "#/entities/appliance" },
      "description": "User appliances."
    },
    "/users/{userId}/activities/{activityId}": {
      "schema": { "$ref": "#/entities/activity" },
      "description": "Activity audit logs."
    }
  }
}
